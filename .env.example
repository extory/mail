# Configure one or both providers; the composer lets users select either.
# auto discovers the latest eligible model (cached for 5 minutes).
# A specific model ID can be used for requests without a UI selection.
OPENAI_API_KEY=
OPENAI_MODEL=auto
GEMINI_API_KEY=
GEMINI_MODEL=auto

# Email (Resend)
RESEND_API_KEY=re_...
SENDER_EMAIL=marketing@yourdomain.com
SENDER_NAME=Newsletter

# Auth
JWT_SECRET=change-this-to-a-random-string

# Base URL (for unsubscribe links)
BASE_URL=https://mail.yourdomain.com

# Resend Webhook (optional, for email statistics)
RESEND_WEBHOOK_SECRET=whsec_...
