# AI Provider - OpenAI takes priority; Gemini is optional
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
GEMINI_API_KEY=

# Email (Resend)
RESEND_API_KEY=re_...
SENDER_EMAIL=marketing@yourdomain.com
SENDER_NAME=Newsletter

# Auth
JWT_SECRET=change-this-to-a-random-string

# Base URL (for unsubscribe links)
BASE_URL=https://mail.yourdomain.com

# Resend Webhook (optional, for email statistics)
RESEND_WEBHOOK_SECRET=whsec_...
